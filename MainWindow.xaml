<Window x:Class="LoopbackRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ゲーム音声リアルタイム翻訳" Height="600" Width="900"
        Background="#1e1e1e">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部: ステータスと操作ボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="StartStopButton" Content="開始" Width="100" Height="32" Click="StartStopButton_Click"/>
            <Button x:Name="SettingsButton" Content="設定" Width="100" Height="32" Margin="8,0,0,0" Click="SettingsButton_Click"/>
            <Button x:Name="ClearButton" Content="クリア" Width="100" Height="32" Margin="8,0,0,0" Click="ClearButton_Click"/>
            <Button x:Name="OverlayButton" Content="オーバーレイ表示" Width="120" Height="32" Margin="8,0,0,0" Click="OverlayButton_Click"/>
            <TextBlock x:Name="StatusText" Text="停止中" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#aaaaaa"/>
        </StackPanel>

        <!-- 中央: 原文/訳文の2ペイン -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#444444" BorderThickness="1" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="原文" FontWeight="Bold" Foreground="White"
                               Background="#2d2d2d" Padding="8"/>
                    <ListBox x:Name="OriginalListBox" Background="#252525" Foreground="White"
                             BorderThickness="0" FontSize="14"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#444444" BorderThickness="1" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="訳文" FontWeight="Bold" Foreground="White"
                               Background="#2d2d2d" Padding="8"/>
                    <ListBox x:Name="TranslatedListBox" Background="#252525" Foreground="#8ecbff"
                             BorderThickness="0" FontSize="14"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
