<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 本体(LoopbackRecorder.csproj)はnet8.0-windows/UseWPF=trueだが、テスト対象の
         VoiceActivitySegmenterはWPF/NAudio/Whisper.netのいずれにも依存しないため、
         このテストプロジェクトはWPF無しのプレーンなnet8.0にしている。
         これにより、WPFワークロードが無い環境(CI等)でも `dotnet test` だけで実行できる。 -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>LoopbackRecorder.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- テスト対象(VoiceActivitySegmenter)のコンストラクタがSileroVadDetector?型を引数に
         取るため、コンパイルを通すにはこのパッケージの型情報が必要になる。
         ただし本テストではSileroVadDetectorのインスタンスは一切生成せず(常にnullを渡し)
         RMSフォールバック経路のみを検証するため、実行時にONNXモデルファイルやランタイムは
         不要(ビルド時の参照のみで完結する)。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!-- AppSettings.cs(DeepL APIキーのDPAPI暗号化)のコンパイルに必要 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 実音声E2Eテスト(PipelineEndToEndTests.cs)用。本体プロジェクト(VoiceTranslator.csproj)と
         同じバージョンを使い、実際にアプリが使うのと寸分違わないVAD→Whisper文字起こし処理を
         このテストプロジェクトからも呼び出せるようにする。
         注意: これによりこのテストプロジェクトの依存が重くなる(Whisper.net.Runtimeはネイティブ
         バイナリを含む)。CI(windows-latest)は本体プロジェクトのビルドで既にこれらを取得しているため
         追加の実行可否には影響しないが、初回のdotnet restoreにかかる時間は増える。
         PipelineEndToEndTests自体は、テスト用音声(TestData/*.wav)やWhisperモデルが手元に
         無い環境では自動的にスキップされるため、これらのパッケージが無くても他のテストの
         実行には影響しない設計にしている。 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト対象の実体は本体プロジェクトのファイルをコピーせずそのままリンク参照する。
         本体側を修正すればこちらにも自動的に反映され、ファイルが二重管理になって
         内容がずれる事態を防ぐ。
         (本体をProjectReferenceで参照しない理由: 本体はUseWPF=trueのnet8.0-windowsのため、
         ProjectReferenceするとテスト側にもWPF一式の依存が伝播してしまうため)
         パスは「このcsprojと同じ階層に本体プロジェクトのフォルダ(LoopbackRecorder)がある」
         構成を想定している。
         例: Desktop\LoopbackRecorder\LoopbackRecorder.csproj と
             Desktop\LoopbackRecorder.Tests\LoopbackRecorder.Tests.csproj が
             同じDesktop直下に並ぶ構成(=LoopbackRecorder.TestsをLoopbackRecorderの
             "中"に置かない)。本体プロジェクトはSDKスタイルでフォルダ内の.csを再帰的に
             自動収集するため、LoopbackRecorder.Testsを本体フォルダの中に置くと、本体の
             ビルドがテストコード側まで誤って取り込んでしまい、ビルドエラーになる。
         フォルダ構成が異なる場合は、このパスを実際の配置に合わせて書き換えてください。 -->
    <Compile Include="..\LoopbackRecorder\VoiceActivitySegmenter.cs" Link="SourceUnderTest\VoiceActivitySegmenter.cs" />
    <Compile Include="..\LoopbackRecorder\SileroVadDetector.cs" Link="SourceUnderTest\SileroVadDetector.cs" />
    <!-- TranslationService.cs(BuildValidatedGlossaryの単体テスト用)。
         HttpClientを使うDeepL/Ollama通信部分自体はモックが必要になるため今回はテスト対象外。
         BuildValidatedGlossaryは外部通信もWPF依存も無い純粋なロジックなので、
         VoiceActivitySegmenterと同じ方式(直接コンパイル)でテストできる。 -->
    <Compile Include="..\LoopbackRecorder\TranslationService.cs" Link="SourceUnderTest\TranslationService.cs" />
    <!-- TranslationConcurrencyLimiter.cs(ConcurrencyLimitedTranslationService)。
         AppSettings.CreateTranslationServiceが返すサービスをラップするため、
         AppSettings.csのテストのコンパイルに必要。 -->
    <Compile Include="..\LoopbackRecorder\TranslationConcurrencyLimiter.cs" Link="SourceUnderTest\TranslationConcurrencyLimiter.cs" />
    <!-- TranslationCache.cs(CachingTranslationService)。同じくAppSettings.CreateTranslationServiceが
         返すサービスをラップするため、AppSettings.csのテストのコンパイルに必要。 -->
    <Compile Include="..\LoopbackRecorder\TranslationCache.cs" Link="SourceUnderTest\TranslationCache.cs" />
    <!-- GameProfile.cs(ゲームプロファイルのモデルとJSON保存/読込)のテスト用。外部通信もWPF依存も無い。 -->
    <Compile Include="..\LoopbackRecorder\GameProfile.cs" Link="SourceUnderTest\GameProfile.cs" />
    <!-- AppSettings.cs(.envの読み書き・クランプ処理)の単体テスト用。
         AppSettings.Hotkeys.cs(WPF依存のホットキー解析部分)はpartial分割してあり、
         テスト側では意図的にIncludeしない(WPF無しでこのプロジェクトをビルドできるようにするため)。
         AppSettingsはLogger/EnvLoader/Languages.cs(LanguageCatalog)に依存するため、
         その3つも合わせて取り込む(Languages.csの取り込み漏れが原因のビルドエラーが
         一度発生したため、依存関係は明示的にコメントしておく)。 -->
    <Compile Include="..\LoopbackRecorder\AppSettings.cs" Link="SourceUnderTest\AppSettings.cs" />
    <Compile Include="..\LoopbackRecorder\Logger.cs" Link="SourceUnderTest\Logger.cs" />
    <Compile Include="..\LoopbackRecorder\EnvLoader.cs" Link="SourceUnderTest\EnvLoader.cs" />
    <Compile Include="..\LoopbackRecorder\Languages.cs" Link="SourceUnderTest\Languages.cs" />
    <!-- LatencyTracker.cs(遅延計算ロジック)のテスト用。PipelineModels.cs(TranscriptItem/
         LatencyMeasurementの定義)も合わせて取り込む(Logger.csは上で取り込み済み)。 -->
    <Compile Include="..\LoopbackRecorder\LatencyTracker.cs" Link="SourceUnderTest\LatencyTracker.cs" />
    <Compile Include="..\LoopbackRecorder\PipelineModels.cs" Link="SourceUnderTest\PipelineModels.cs" />
    <!-- SegmentDeduplicator.cs(重複除去ロジック)のテスト用。外部依存なし。 -->
    <Compile Include="..\LoopbackRecorder\SegmentDeduplicator.cs" Link="SourceUnderTest\SegmentDeduplicator.cs" />
    <!-- TranslationWorker.cs(翻訳ワーカーループ)のテスト用。ITranslationServiceは
         TranslationService.cs(上で取り込み済み)で定義されているため追加のIncludeは不要。 -->
    <Compile Include="..\LoopbackRecorder\TranslationWorker.cs" Link="SourceUnderTest\TranslationWorker.cs" />
    <!-- OverlayLineOrderer.cs(オーバーレイの行並び替えロジック)のテスト用。WPF非依存の
         純粋なクラスなので、OverlayWindow.xaml.cs(WPF依存)本体は取り込まずこれだけで完結する。 -->
    <Compile Include="..\LoopbackRecorder\OverlayLineOrderer.cs" Link="SourceUnderTest\OverlayLineOrderer.cs" />
  </ItemGroup>

</Project>
