<Window x:Class="LoopbackRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="640" Width="720"
        Background="#12121a" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#29C7C1" Offset="0"/>
            <GradientStop Color="#7B5FE0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4da6ff"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#aaaaba"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#23232f"/>
                                <Setter Property="Foreground" Value="#29C7C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Click="CancelButton_Click"/>
            <Button Content="保存" Width="90" Height="30" Margin="8,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="" Foreground="#ffaa66" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- 左サイドバー -->
        <Border DockPanel.Dock="Left" Width="150" Background="#1a1a24" CornerRadius="10" Margin="0,0,12,0" Padding="8">
            <StackPanel>
                <RadioButton x:Name="NavAudio" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE720;" Content="音声" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavRecognition" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE713;" Content="認識(AI)" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTranslation" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE774;" Content="翻訳" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavOverlay" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE7F4;" Content="オーバーレイ" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE946;" Content="このアプリについて" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- 右側コンテンツ -->
        <Border Background="#1a1a24" CornerRadius="10" Padding="20">
            <Grid>
                <!-- ==== 音声ページ ==== -->
                <ScrollViewer x:Name="AudioPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="デバイスとルーティング" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="音声デバイス" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DeviceComboBox" Margin="0,0,0,4"/>
                        <TextBlock Text="デバイス名に含まれるキーワードで自動選択されます(例: CABLE, Chat)"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="相手側VAD" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VAD感度(発話検出の閾値)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=VadThresholdSlider, Path=Value, StringFormat='{}{0:F3}'}"/>
                        </Grid>
                        <Slider x:Name="VadThresholdSlider" Minimum="0.001" Maximum="0.05" TickFrequency="0.001"
                                Value="0.015" IsMoveToPointEnabled="True" Margin="0,0,0,8"/>

                        <CheckBox x:Name="GameAudioPriorityCheckBox" Content="ゲーム音声優先モード(小さい雑音より大きい音声を優先)"
                                  Foreground="#cccccc" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== 認識(AI)ページ ==== -->
                <ScrollViewer x:Name="RecognitionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="文字起こしモデル" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Whisperモデル" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="WhisperModelComboBox" IsEditable="True" Margin="0,0,0,4"/>
                        <TextBlock Text="フォルダ内の ggml-*.bin を自動検出します。ノイズが多い音声には small 以上を推奨"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="認識のヒント(任意)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WhisperPromptTextBox" Margin="0,0,0,4" TextWrapping="Wrap" AcceptsReturn="False"/>
                        <TextBlock Text="固有名詞など聞き取ってほしい単語をカンマ区切りで入力すると、認識精度が上がることがあります(例: Balmoral, Buckingham Palace, Queen Elizabeth)"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="認識言語" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RecognitionLanguageComboBox" DisplayMemberPath="Display" Margin="0,0,0,4"/>
                        <TextBlock Text="話者の言語が分かっている場合は指定すると、短い発話での言語誤判定(他言語混入)を防げます"
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== 翻訳ページ ==== -->
                <ScrollViewer x:Name="TranslationPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="翻訳エンジン" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="翻訳先言語" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TargetLanguageComboBox" DisplayMemberPath="Display" Margin="0,0,0,16"/>

                        <TextBlock Text="翻訳バックエンド" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="BackendComboBox" Margin="0,0,0,16" SelectionChanged="BackendComboBox_SelectionChanged">
                            <ComboBoxItem Content="DeepL API(クラウド)" Tag="deepl"/>
                            <ComboBoxItem Content="Ollama(ローカルAI)" Tag="ollama"/>
                        </ComboBox>

                        <StackPanel x:Name="DeepLPanel">
                            <TextBlock Text="DeepL APIキー" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DeepLApiKeyTextBox" Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel x:Name="OllamaPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ollamaモデル名" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="Ollamaアプリが起動している必要があります。未起動の場合、モデル一覧の自動取得や翻訳ができません。"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox x:Name="OllamaModelComboBox" IsEditable="True" Margin="0,0,0,4"/>
                            <TextBlock Text="インストール済みのモデルを自動検出します(Ollama起動時)。手入力も可能です"
                                       Style="{StaticResource HelpText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ollamaエンドポイント" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="通常は http://localhost:11434 のままで問題ありません。別のPCでOllamaを動かしている場合のみ変更してください。"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="OllamaEndpointTextBox" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="参考コンテキスト(任意)" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="Wikipedia記事の抜粋など、話題の背景知識を貼り付けておくと、認識開始時に固有名詞の対訳リストが自動抽出され、翻訳時の補正に使われます(Ollama使用時のみ有効)。"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="OllamaContextTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
                            <TextBlock Text="話題に関連する記事などを貼り付けておくと、固有名詞の誤翻訳を文脈から補正しやすくなります"
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== オーバーレイページ ==== -->
                <StackPanel x:Name="OverlayPage" Visibility="Collapsed">
                    <TextBlock Text="見た目" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文字サイズ" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayFontSizeSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayFontSizeSlider" Minimum="14" Maximum="48" TickFrequency="1"
                            Value="22" IsMoveToPointEnabled="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景の不透明度" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayOpacitySlider, Path=Value, StringFormat='{}{0:F2}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                            Value="0.7" IsMoveToPointEnabled="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大表示件数" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayMaxLinesSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayMaxLinesSlider" Minimum="1" Maximum="10" TickFrequency="1"
                            Value="4" IsMoveToPointEnabled="True" Margin="0,0,0,4"/>
                    <TextBlock Text="ゲームでとっさに読みたい場合は1〜2、ニュースなど連続した会話には3〜5がおすすめです。最新の発話ほど明るく表示されます。"
                               Style="{StaticResource HelpText}"/>

                    <TextBlock Text="ドラッグでの移動・端をつまんでのリサイズはオーバーレイ表示中いつでも行えます。"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <!-- ==== このアプリについてページ ==== -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="ゲーム音声リアルタイム翻訳" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Whisper.net(音声認識) + DeepL API / Ollama(翻訳)を組み合わせた個人開発アプリです。"
                               Foreground="#aaaaaa" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="リポジトリ: github.com/Myubd/voice-translator" Foreground="#4da6ff"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
