<Window x:Class="LoopbackRecorder.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="訳文オーバーレイ"
        Width="500" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- 半透明の背景。ゲーム画面が透けて見えるようにする -->
        <Border x:Name="BackgroundBorder" Background="#B0000000" CornerRadius="16" BorderBrush="#5529C7C1" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#29C7C1" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上部のつまみ部分(ドラッグ移動・OCR翻訳起動・閉じるボタン用)。ゲーム上での誤操作を避けるため最小限に -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="⠿⠿⠿" Foreground="#66FFFFFF" FontSize="10" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- ゲーム中はMainWindowを操作しづらいため、Ctrl+Alt+Tホットキーに加えて
                             このオーバーレイからもOCR単発翻訳(画面の範囲選択→翻訳)を起動できるようにする。
                             実際の処理(範囲選択オーバーレイの表示以降)はMainWindow側が持っているため、
                             ここではOcrRequestedイベントを発火するだけに留める。 -->
                        <Button x:Name="OcrButton" Content="🔍" Width="20" Height="20" Padding="0"
                                ToolTip="範囲を選択してOCR翻訳(Ctrl+Alt+T)"
                                Background="Transparent" Foreground="#AAFFFFFF"
                                BorderThickness="0" Click="OcrButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="CloseButton" Content="✕" Width="20" Height="20" Padding="0"
                                Background="Transparent" Foreground="#AAFFFFFF"
                                BorderThickness="0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 訳文本体(複数行を履歴として積み上げ、最新行が見えるよう自動スクロールする) -->
                <ListBox Grid.Row="1" x:Name="TranslatedListBox"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Foreground}"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Tag}"
                                       FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2">
                                <!-- 文字自体への縁取り(黒いハロー)。ゲーム画面はほぼ何色でも背景になり得るため、
                                     背景Borderの半透明黒だけでは、明るい/白っぽいシーンの上や、オーバーレイの
                                     不透明度を下げて使っているユーザーでは訳文が視認しづらくなることがある。
                                     WPFには文字そのものへのストローク描画機能が無いため、DropShadowEffectを
                                     ShadowDepth=0(真後ろ)・低BlurRadiusで掛けることで、疑似的な縁取りとして
                                     代用している(BackgroundBorderの縁の光彩と同じ手法)。 -->
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
