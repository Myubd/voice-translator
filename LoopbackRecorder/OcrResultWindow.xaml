<Window x:Class="LoopbackRecorder.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR翻訳結果"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F0202020">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Text="認識中..." Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="認識したテキスト" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,2"/>
        <TextBox Grid.Row="2" x:Name="OriginalTextBox"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 Background="#22FFFFFF" Foreground="White" BorderThickness="0" Padding="6"/>

        <TextBlock Grid.Row="3" Text="翻訳結果" Foreground="#88FFFFFF" FontSize="11" Margin="0,10,0,2"/>
        <TextBox Grid.Row="4" x:Name="TranslatedTextBox"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MaxHeight="160" VerticalScrollBarVisibility="Auto"
                 Background="#22FFFFFF" Foreground="#29C7C1" FontWeight="Bold" BorderThickness="0" Padding="6"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="訳文をコピー" Padding="10,4" Margin="0,0,8,0" Click="CopyButton_Click"/>
            <Button x:Name="CloseButton" Content="閉じる" Padding="10,4" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
