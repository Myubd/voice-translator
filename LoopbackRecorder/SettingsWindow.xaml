<Window x:Class="LoopbackRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="680" Width="720" MinWidth="680" MaxWidth="820" MinHeight="480"
        Background="#12121a" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- 既定のOS標準スクロールバー(幅17px前後で、ダークテーマの中で太く浮いて見える)の代わりに、
             細身のダークテーマに馴染むスクロールバーを使う。RepeatButton(トラック部分クリックでの
             ページ送り)は省略している(ドラッグ・マウスホイールでのスクロールは通常通り機能する)ため、
             見た目重視のミニマルなテンプレートになっている。 -->
        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#3a3a4a" CornerRadius="3" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#29C7C1" Offset="0"/>
            <GradientStop Color="#7B5FE0" Offset="1"/>
        </LinearGradientBrush>

        <!-- MainWindowのPrimaryButton/AccentGradientと同じ配色に揃えている(アプリ全体で
             「主要な決定操作」の色を統一するため)。設定画面では保存ボタンのみに使う。
             上のAccentGradientより後ろに置くこと(ControlTemplate内でTemplateBinding経由の
             Background参照が絡む場合、前方参照だとWPF側でうまく解決されずクラッシュすることがある)。 -->
        <Style x:Key="PrimarySaveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4da6ff"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#aaaaba"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#23232f"/>
                                <Setter Property="Foreground" Value="#29C7C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimarySaveButton}" Content="保存" Width="100" Height="32"
                    Margin="8,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- エラー・警告メッセージ用のアラートボックス。中身が空の間はCollapsedにし、
             メッセージがセットされた時だけ表示する(SetStatusMessage経由で両方を連動させる)。
             どの操作も「1つの汎用メッセージ欄」を使い回しているため(Ollama接続エラー、
             ショートカットキーの重複、リンクを開けない等)、種別ごとの出し分けはせず
             すべて同じ見た目の警告色で統一している。 -->
        <Border x:Name="StatusMessageBanner" DockPanel.Dock="Bottom" Background="#3a1f1f" BorderBrush="#8a3a3a"
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#ff8a8a"
                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="StatusText" Text="" Foreground="#ffb3b3" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 翻訳実行中に設定を開いた場合のみ表示。ここでの変更(モデル名・APIキー等)は
             実行中のパイプラインには即座に反映されないため、その旨を明示する -->
        <Border x:Name="RunningWarningBanner" DockPanel.Dock="Top" Background="#3a2f14" CornerRadius="6"
                Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Text="⚠ 翻訳実行中です。ここでの変更は今すぐには反映されません。「停止」してから「翻訳開始」で再開すると反映されます。"
                       Foreground="#ffcc66" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- 左サイドバー -->
        <Border DockPanel.Dock="Left" Width="150" Background="#1a1a24" CornerRadius="10" Margin="0,0,12,0" Padding="8">
            <StackPanel>
                <RadioButton x:Name="NavAudio" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE720;" Content="音声" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavEngine" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE713;" Content="エンジン" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavLanguage" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE774;" Content="言語" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavOverlay" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE7F4;" Content="オーバーレイ" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavProfiles" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE8FD;" Content="ゲームプロファイル" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavShortcuts" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE765;" Content="ショートカット" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource NavButton}"
                             Tag="&#xE946;" Content="このアプリについて" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- 右側コンテンツ -->
        <Border Background="#1a1a24" CornerRadius="10" Padding="20">
            <Grid>
                <!-- ==== 音声ページ ==== -->
                <ScrollViewer x:Name="AudioPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="デバイスとルーティング" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="音声デバイス" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DeviceComboBox" Margin="0,0,0,4"/>
                        <TextBlock Text="選択したデバイスはOS上の一意なIDで保存されるため、同名デバイスが複数あっても区別されます。デバイス構成が変わってIDが見つからない場合のみ、デバイス名の部分一致(例: CABLE, Chat)にフォールバックします"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="相手側VAD" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="発話検出にはSilero VAD(ONNXニューラルモデル)を使用しており、音量だけでなく声道特有の周波数特性も加味して人声を検出します(モデルが利用できない場合は簡易的なRMS方式に自動フォールバックします)"
                                   Style="{StaticResource HelpText}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VAD感度(発話検出の確率閾値)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=VadThresholdSlider, Path=Value, StringFormat='{}{0:F2}'}"/>
                        </Grid>
                        <Slider x:Name="VadThresholdSlider" Minimum="0.05" Maximum="0.95" TickFrequency="0.05"
                                Value="0.5" IsMoveToPointEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="値を大きくするほど、発話である確信度が高い音声だけを拾うようになります(誤検出は減りますが、小さい声や不明瞭な発話を拾いにくくなることがあります)"
                                   Style="{StaticResource HelpText}"/>
                        <TextBlock Text="" Margin="0,0,0,4"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="発話継続のしやすさ(ヒステリシス)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=VadHysteresisSlider, Path=Value, StringFormat='{}{0:F2}'}"/>
                        </Grid>
                        <Slider x:Name="VadHysteresisSlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05"
                                Value="0.6" IsMoveToPointEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="小さくするほど、一度話し始めた発話は多少声が小さくなっても『継続中』とみなされやすくなり、息継ぎなどでの意図しない分断を抑えられます。1.0で従来と同じ挙動(単一閾値)になります"
                                   Style="{StaticResource HelpText}"/>

                        <CheckBox x:Name="GameAudioPriorityCheckBox" Content="ゲーム音声優先モード(小さい雑音より大きい音声を優先)"
                                  Foreground="#cccccc" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="優先モードの倍率(VAD閾値に掛ける値)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=GameAudioPriorityMultiplierSlider, Path=Value, StringFormat='{}{0:F1}倍'}"/>
                        </Grid>
                        <Slider x:Name="GameAudioPriorityMultiplierSlider" Minimum="1.0" Maximum="3.0" TickFrequency="0.1"
                                Value="1.5" IsMoveToPointEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="以前は1.5倍固定でしたが、環境によって最適な倍率が異なるためここで調整できるようにしました。大きくするほど小さい音(ボイスチャットや環境音を含む)を拾わなくなります"
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== エンジンページ(モデル・翻訳バックエンドなど、機能そのものの選択) ==== -->
                <ScrollViewer x:Name="EnginePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="文字起こしモデル" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Whisperモデル" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="WhisperModelComboBox" IsEditable="True" Margin="0,0,0,4"/>
                        <TextBlock Text="フォルダ内の ggml-*.bin を自動検出します。ノイズが多い音声には small 以上を推奨"
                                   Style="{StaticResource HelpText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Whisperスレッド数" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                            <TextBlock Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=WhisperThreadCountSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                        </StackPanel>
                        <!-- MaximumはCPUの論理コア数に応じて実行時にコードビハインドから設定する(SettingsWindow.xaml.cs参照) -->
                        <Slider x:Name="WhisperThreadCountSlider" Minimum="1" Maximum="16"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="文字起こしに使うCPUスレッド数。大きいほど処理は速くなりますが、ゲームなど他アプリの動作が重くなることがあります"
                                   Style="{StaticResource HelpText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="翻訳ワーカー数" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                            <TextBlock Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=TranslationWorkerCountSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                        </StackPanel>
                        <Slider x:Name="TranslationWorkerCountSlider" Minimum="1" Maximum="4"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="翻訳を同時に何件まで並行処理するか。大きいほど発話が連続してもキューが詰まりにくくなりますが、DeepL無料プランではレート制限に引っかかりやすくなります"
                                   Style="{StaticResource HelpText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="最大許容遅延(秒)" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                            <TextBlock Foreground="#4da6ff" FontWeight="Bold"
                                       Text="{Binding ElementName=MaxLatencySecondsSlider, Path=Value, StringFormat='{}{0:F1}秒'}"/>
                        </StackPanel>
                        <Slider x:Name="MaxLatencySecondsSlider" Minimum="0" Maximum="10" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                        <TextBlock Text="発話が終わってからこの秒数を超えても処理が追いついていない場合、その発話は諦めて最新の会話を優先します(ゲーム実況向け)。0にすると無効化し、どんなに遅れても必ず全部処理します"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="翻訳エンジン" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="翻訳バックエンド" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="BackendComboBox" Margin="0,0,0,4" SelectionChanged="BackendComboBox_SelectionChanged">
                            <ComboBoxItem Content="DeepL API(クラウド)" Tag="deepl"/>
                            <ComboBoxItem Content="Ollama(ローカルAI)" Tag="ollama"/>
                        </ComboBox>

                        <CheckBox x:Name="TranslationCacheCheckBox"
                                  Content="同じ原文の翻訳結果をキャッシュする" Foreground="#cccccc" Margin="0,0,0,4"/>
                        <TextBlock Text="「gg」「nice」等の短い定型句が繰り返された場合、2回目以降はAPI呼び出しを省略して即座に表示します(完全に同じ文字列の場合のみ)"
                                   Style="{StaticResource HelpText}" Margin="0,0,0,16"/>

                        <StackPanel x:Name="DeepLPanel">
                            <TextBlock Text="DeepL APIキー" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 既定はPasswordBoxで表示(画面共有・配信中の映り込み対策)。
                                     必要な場合のみ「表示」トグルで平文のTextBoxに切り替える -->
                                <PasswordBox x:Name="DeepLApiKeyPasswordBox" Grid.Column="0"
                                             PasswordChanged="DeepLApiKeyPasswordBox_PasswordChanged"/>
                                <TextBox x:Name="DeepLApiKeyTextBox" Grid.Column="0" Visibility="Collapsed"
                                         TextChanged="DeepLApiKeyTextBox_TextChanged"/>
                                <ToggleButton x:Name="DeepLApiKeyVisibilityToggle" Grid.Column="1"
                                              Content="表示" Width="52" Margin="6,0,0,0"
                                              Checked="DeepLApiKeyVisibilityToggle_Checked"
                                              Unchecked="DeepLApiKeyVisibilityToggle_Unchecked"/>
                            </Grid>
                            <CheckBox x:Name="DeepLToOllamaFallbackCheckBox"
                                      Content="DeepLが失敗した場合、自動的にOllamaへ切り替える" Foreground="#cccccc" Margin="0,0,0,4"
                                      Checked="DeepLToOllamaFallbackCheckBox_CheckedChanged"
                                      Unchecked="DeepLToOllamaFallbackCheckBox_CheckedChanged"/>
                            <TextBlock Text="Ollamaが別途セットアップ済みの場合のみ有効にしてください。下のOllama設定(モデル名・エンドポイント)がフォールバック先としてそのまま使われます"
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>

                        <StackPanel x:Name="OllamaPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ollamaモデル名" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="Ollamaアプリが起動している必要があります。未起動の場合、モデル一覧の自動取得や翻訳ができません。"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox x:Name="OllamaModelComboBox" IsEditable="True" Margin="0,0,0,4"/>
                            <TextBlock Text="インストール済みのモデルを自動検出します(Ollama起動時)。手入力も可能です"
                                       Style="{StaticResource HelpText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ollamaエンドポイント" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="通常は http://localhost:11434 のままで問題ありません。別のPCでOllamaを動かしている場合のみ変更してください。"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OllamaEndpointTextBox" Grid.Column="0" Margin="0,0,4,0"/>
                                <Button x:Name="OllamaEndpointRefreshButton" Grid.Column="1" Content="モデル一覧を更新"
                                        Click="OllamaEndpointRefreshButton_Click"/>
                            </Grid>
                            <TextBlock Text="エンドポイントを変更した場合は「モデル一覧を更新」でこの接続先のモデルを再取得してください"
                                       Style="{StaticResource HelpText}"/>

                            <StackPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="参考コンテキスト(任意)" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="Wikipedia記事の抜粋など、話題の背景知識を貼り付けておくと、認識開始時に固有名詞の対訳リストが自動抽出され、翻訳時の補正に使われます(Ollama使用時のみ有効。DeepL→Ollamaフォールバック使用時、フォールバック発生時にも使われます)。"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="OllamaContextTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
                                <TextBlock Text="話題に関連する記事などを貼り付けておくと、固有名詞の誤翻訳を文脈から補正しやすくなります"
                                           Style="{StaticResource HelpText}"/>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="手動用語集(任意)" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <TextBlock Text="ⓘ" Foreground="#6688aa" Cursor="Help">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="固有名詞の訳語を確実に固定したい場合、上の参考コンテキストによるAI自動抽出に頼らず、ここに直接指定できます。1行に1エントリ、「原文 => 訳語」の形式で記述してください(例: Aetherium => エーテリウム)。参考コンテキスト側の自動抽出と同じ原文が指定された場合は、こちらの手動指定が優先されます。"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="ManualGlossaryTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
                                <TextBlock Text="1行1エントリ、「原文 => 訳語」の形式(例: Aetherium => エーテリウム)。参考コンテキストの自動抽出より優先されます"
                                           Style="{StaticResource HelpText}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== 言語ページ(認識言語・翻訳先言語のみ。Ollama用の参考コンテキストは
                     翻訳エンジンの設定そのものであり、エンジンタブのOllama設定と一体で
                     表示/非表示が切り替わる方が自然なため、エンジンタブ側へ移設した) ==== -->
                <ScrollViewer x:Name="LanguagePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="認識(音声 → 原文)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="認識のヒント(任意)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WhisperPromptTextBox" Margin="0,0,0,4" TextWrapping="Wrap" AcceptsReturn="False"/>
                        <TextBlock Text="固有名詞など聞き取ってほしい単語をカンマ区切りで入力すると、認識精度が上がることがあります(例: ゲーム内のキャラクター名、地名、アイテム名など)"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="認識言語(原文)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RecognitionLanguageComboBox" DisplayMemberPath="Display" Margin="0,0,0,4"/>
                        <TextBlock Text="話者の言語が分かっている場合は指定すると、短い発話での言語誤判定(他言語混入)を防げます"
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="翻訳(原文 → 訳文)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="翻訳先言語(訳文)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TargetLanguageComboBox" DisplayMemberPath="Display" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== オーバーレイページ ==== -->
                <StackPanel x:Name="OverlayPage" Visibility="Collapsed">
                    <TextBlock Text="見た目" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文字サイズ" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayFontSizeSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayFontSizeSlider" Minimum="14" Maximum="48" TickFrequency="1"
                            Value="22" IsMoveToPointEnabled="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景の不透明度" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayOpacitySlider, Path=Value, StringFormat='{}{0:F2}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                            Value="0.7" IsMoveToPointEnabled="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大表示件数" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Foreground="#4da6ff" FontWeight="Bold"
                                   Text="{Binding ElementName=OverlayMaxLinesSlider, Path=Value, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <Slider x:Name="OverlayMaxLinesSlider" Minimum="1" Maximum="10" TickFrequency="1"
                            Value="4" IsMoveToPointEnabled="True" Margin="0,0,0,4"/>
                    <TextBlock Text="ゲームでとっさに読みたい場合は1〜2、ニュースなど連続した会話には3〜5がおすすめです。最新の発話だけ太字・不透明で表示され、それ以外は少し薄く表示されます。"
                               Style="{StaticResource HelpText}"/>

                    <TextBlock Text="文字色" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                    <StackPanel x:Name="OverlayColorSwatchPanel" Orientation="Horizontal"/>
                    <TextBlock Text="ゲーム画面の色味によって、白だと見えにくい場合に変更してください"
                               Style="{StaticResource HelpText}"/>

                    <TextBlock Text="ドラッグでの移動・端をつまんでのリサイズはオーバーレイ表示中いつでも行えます。画面端に近づけると吸着します。"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <!-- ==== ゲームプロファイルページ ==== -->
                <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
                    <TextBlock Text="ゲームプロファイル" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="「翻訳エンジン」「言語」「オーバーレイ」タブの設定内容をゲームごとに名前を付けて保存し、切り替えられます(デバイス選択・ホットキー・APIキーなどは対象外で、切り替えても変わりません)。"
                               Style="{StaticResource HelpText}" Margin="0,0,0,16"/>

                    <TextBlock Text="保存済みプロファイル" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProfileListComboBox" Margin="0,0,0,8"
                              SelectionChanged="ProfileListComboBox_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="ProfileLoadButton" Content="このプロファイルを読み込む" Height="30" Padding="10,0"
                                Click="ProfileLoadButton_Click"/>
                        <Button x:Name="ProfileDeleteButton" Content="削除" Height="30" Padding="10,0" Margin="8,0,0,0"
                                Click="ProfileDeleteButton_Click"/>
                    </StackPanel>
                    <TextBlock Text="読み込むと、上記3タブの入力欄の内容がこの画面上で置き換わります。実際に反映されるのは、この設定画面自体を「保存」した時です。"
                               Style="{StaticResource HelpText}" Margin="0,0,0,16"/>

                    <TextBlock Text="現在の内容を新しいプロファイルとして保存" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNewNameTextBox" Grid.Column="0"/>
                        <Button x:Name="ProfileSaveButton" Grid.Column="1" Content="保存" Height="Auto" Padding="14,4"
                                Margin="8,0,0,0" Click="ProfileSaveButton_Click"/>
                    </Grid>
                    <TextBlock Text="この画面で現在入力中の「翻訳エンジン」「言語」「オーバーレイ」タブの内容がそのまま保存されます(この設定画面自体の保存は不要です)。同名のプロファイルが既にある場合は上書きされます。"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <!-- ==== ショートカットページ ==== -->
                <StackPanel x:Name="ShortcutPage" Visibility="Collapsed">
                    <TextBlock Text="グローバルショートカットキー" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="ウィンドウが非アクティブ(ゲームがアクティブ)な状態でも動作します。他のアプリで既に同じ組み合わせが使われている場合、登録に失敗して従来のボタン操作のみになることがあります。"
                               Style="{StaticResource HelpText}"/>

                    <TextBlock Text="翻訳の開始/停止" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#22222f" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock x:Name="StartStopHotkeyText" Foreground="#4da6ff" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <Button Grid.Column="1" Content="変更" Width="70" Height="32" Click="StartStopHotkeyChangeButton_Click"/>
                    </Grid>

                    <TextBlock Text="オーバーレイ表示切り替え" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#22222f" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock x:Name="OverlayHotkeyText" Foreground="#4da6ff" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <Button Grid.Column="1" Content="変更" Width="70" Height="32" Click="OverlayHotkeyChangeButton_Click"/>
                    </Grid>
                    <TextBlock Text="「変更」を押した後、設定したいキーの組み合わせを押してください。Ctrl・Alt・Shift・Winのいずれか1つ以上を含める必要があります。Escキーで取り消せます。"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <!-- ==== このアプリについてページ ==== -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <TextBlock Text="ゲーム音声リアルタイム翻訳" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Whisper.net(音声認識) + DeepL API / Ollama(翻訳)を組み合わせた個人開発アプリです。"
                               Foreground="#aaaaaa" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Margin="0,0,0,16">
                        <Run Text="リポジトリ: " Foreground="#aaaaaa"/>
                        <Hyperlink NavigateUri="https://github.com/Myubd/voice-translator" RequestNavigate="RepositoryLink_RequestNavigate">
                            github.com/Myubd/voice-translator
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
